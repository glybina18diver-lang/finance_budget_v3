/* ========== QTabWidget (вкладки) ========== */

QTabWidget::pane {
    border: 1px solid $BORDER$;
    border-radius: $RADIUS_SMALL$;
    background-color: $BG_SECONDARY$;
}

QTabBar::tab {
    background-color: $TAB_BG$;
    color: $TEXT_SECONDARY$;
    padding: 6px 14px;
    border: 1px solid $BORDER$;
    border-bottom: none;
    border-top-left-radius: $RADIUS_SMALL$;
    border-top-right-radius: $RADIUS_SMALL$;
    min-width: 80px;
}

QTabBar::tab:selected {
    background-color: $BG_SECONDARY$;   /* сливается с pane */
    color: $TEXT_PRIMARY$;
    font-weight: 600;
    margin-bottom: -1px;                /* «приклеивает» вкладку к панели */
}

QTabBar::tab:hover:!selected {
    background-color: $TAB_HOVER$;
}

/* Опционально: акцент сущности на активной вкладке */
QTabWidget[purpose="transfers"] QTabBar::tab:selected {
    color: $ENTITY_TRANSFERS$;
}
QTabWidget[purpose="loans"] QTabBar::tab:selected {
    color: $ENTITY_LOANS$;
}

/* ========== QGroupBox ========== */

QGroupBox {
    background-color: $BG_SECONDARY$;
    border: 1px solid $BORDER$;
    border-radius: $RADIUS_SMALL$;
    margin-top: 8px;                    /* место под заголовок */
    padding: 12px 8px 8px 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: $TEXT_SECONDARY$;
}

/* ========== Панель (контейнер для layout) ========== */

QWidget[variant="panel"] {
    background-color: $BG_SECONDARY$;
    border: 1px solid $BORDER$;
    border-radius: $RADIUS_SMALL$;
}

/* ========== QCheckBox ========== */
QCheckBox {
    background-color: $BG_SECONDARY$;
    color: $TEXT_SECONDARY$;
}

/* ========== КОЛОНКИ СЧЕТОВ ========== */

QScrollArea#accounts_scroll {
    background-color: $BG_SECONDARY$;
    border: 1px solid $BORDER$;
    border-radius: $RADIUS_SMALL$;
}

/* Внутренние слои прозрачны, чтобы не закрывать скругление рамки */
QScrollArea#accounts_scroll > QWidget,   /* viewport */
QWidget#accounts_content {               /* контейнер строк */
    background-color: transparent;
}

/* ========== СЛУЖЕБНЫЕ НАДПИСИ ========== */

QLabel[variant="header"] {
    font-size: $FONT_SIZE_HEADER$;
    font-weight: bold;
}

QLabel[variant="muted"] {
    color: $TEXT_SECONDARY$;
    font-style: italic;
    padding: 40px;
}

QLabel[variant="error"] {
    color: $DANGER$;
    padding: 30px;
}

/* ========== КАРТОЧКИ (variant) ========== (неоновая тема) */

QWidget[variant="topbar"] {
    background-color: $BG_SECONDARY$;
    border-radius: $RADIUS_LARGE$;
    padding: 10px;
}

QWidget[variant="balance_card"] {
    background: $GRADIENT_CARD$;
    border: 1px solid $ACCENT_PRIMARY$;
    border-radius: $RADIUS_LARGE$;
    padding: 15px;
}

QWidget[variant="account_card"] {
    background-color: $BG_SECONDARY$;
    border: 1px solid $BORDER$;
    border-radius: $RADIUS_MEDIUM$;
    padding: 12px;
}

QWidget[variant="account_card"]:hover {
    border: 1px solid $ACCENT_SECONDARY$;
}

QWidget[variant="chart_card"] {
    background-color: $BG_SECONDARY$;
    border: 1px solid $BORDER$;
    border-radius: $RADIUS_LARGE$;
    padding: 15px;
}

/* ========== КНОПКИ: градиент и контур ========== (неоновая тема)*/

QPushButton[variant="primary"] {
    background: $GRADIENT_ACCENT$;
    color: white;
    border: none;
    border-radius: $RADIUS_MEDIUM$;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton[variant="primary"]:hover {
    background: $GRADIENT_ACCENT_HOVER$;
}

QPushButton[variant="outline"] {
    background-color: $BG_ELEVATED$;
    color: $ACCENT_SECONDARY$;
    border: 1px solid $ACCENT_SECONDARY$;
    border-radius: $RADIUS_MEDIUM$;
    padding: 10px 20px;
    font-weight: bold;
}

/* ========== МЕТКИ ИТОГОВ ========== */

QLabel[variant="summary-count"] {
    color: $SUMMARY_NEUTRAL$;
    font-size: 13px;
    padding: 0 4px;
}

QLabel[variant="summary-income"] {
    color: $SUMMARY_INCOME$;
    font-size: 13px;
    padding: 0 4px;
}

QLabel[variant="summary-expense"] {
    color: $SUMMARY_EXPENSE$;
    font-size: 13px;
    padding: 0 4px;
}

QLabel[variant="summary-return"] {
    color: $SUMMARY_RETURN$;
    font-weight: bold;
    font-size: 13px;
    padding: 0 4px;
}

QLabel[variant="summary-period"] {
    color: $SUMMARY_PERIOD$;
    font-style: italic;
    font-size: 12px;
    padding: 0 6px;
}

QLabel[variant="summary-selection"] {
    color: $SUMMARY_SELECTION$;
    font-weight: 600;
    font-size: 12px;
    padding-left: 10px;
    border-left: 1px solid $BORDER$;
}

/* Разделитель между метками итогов */
QFrame[variant="summary-separator"] {
    color: $BORDER$;
}