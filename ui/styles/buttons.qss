/* ========== КОМПАКТНЫЕ КНОПКИ (CompactButton) ========== */

/* База: размер только визуально, высота задаётся из Python (setFixedHeight) */
QPushButton[variant="compact"] {
    color: white;
    border: none;
    border-radius: 4px;
    padding: 5px 10px;
    font-weight: 500;
    font-size: $FONT_SIZE_COMPACT$;
    margin: 1px;
}

QPushButton[variant="compact"]:disabled {
    background-color: $COMPACT_DISABLED_BG$;
    color: $COMPACT_DISABLED_TEXT$;
}

/* --- SUCCESS (зелёный) --- */
QPushButton[purpose="success"] {background-color: $COMPACT_SUCCESS$;}
QPushButton[purpose="success"]:hover {background-color: $COMPACT_SUCCESS_HOVER$;}
QPushButton[purpose="success"]:pressed {background-color: $COMPACT_SUCCESS_PRESSED$;}

/* --- INFO (синий) --- */
QPushButton[purpose="info"] {background-color: $COMPACT_INFO$;}
QPushButton[purpose="info"]:hover {background-color: $COMPACT_INFO_HOVER$;}
QPushButton[purpose="info"]:pressed {background-color: $COMPACT_INFO_PRESSED$;}

/* --- WARNING (оранжевый) --- */
QPushButton[purpose="warning"] {background-color: $COMPACT_WARNING$;}
QPushButton[purpose="warning"]:hover {background-color: $COMPACT_WARNING_HOVER$;}
QPushButton[purpose="warning"]:pressed {background-color: $COMPACT_WARNING_PRESSED$;}

/* --- DANGER (красный) --- */
QPushButton[purpose="danger"] {background-color: $COMPACT_DANGER$;}
QPushButton[purpose="danger"]:hover {background-color: $COMPACT_DANGER_HOVER$;}
QPushButton[purpose="danger"]:pressed {background-color: $COMPACT_DANGER_PRESSED$;}

/* --- NEUTRAL (серый) --- */
QPushButton[purpose="neutral"] {background-color: $COMPACT_NEUTRAL$;}
QPushButton[purpose="neutral"]:hover {background-color: $COMPACT_NEUTRAL_HOVER$;}
QPushButton[purpose="neutral"]:pressed {background-color: $COMPACT_NEUTRAL_PRESSED$;}

/* ========== ВАРИАНТ: OPERATION (кнопки открытия диалогов) ========== */

QPushButton[variant="operation"] {
    color: white;
    border: none;
    border-radius: 3px;
    padding: 4px 12px;
    font-weight: 500;
    font-size: 11px;
    min-width: 80px;
}

/* ========== ЦВЕТА ПО PURPOSE (общие для всех variant) ========== */

QPushButton[purpose="accounts"] { background-color: $ENTITY_ACCOUNTS$; }
QPushButton[purpose="accounts"]:hover { background-color: $ENTITY_ACCOUNTS_HOVER$; }
QPushButton[purpose="accounts"]:pressed { background-color: $ENTITY_ACCOUNTS_PRESSED$; }

QPushButton[purpose="categories"] { background-color: $ENTITY_CATEGORIES$; }
QPushButton[purpose="categories"]:hover { background-color: $ENTITY_CATEGORIES_HOVER$; }
QPushButton[purpose="categories"]:pressed { background-color: $ENTITY_CATEGORIES_PRESSED$; }

QPushButton[purpose="transfers"] { background-color: $ENTITY_TRANSFERS$; }
QPushButton[purpose="transfers"]:hover { background-color: $ENTITY_TRANSFERS_HOVER$; }
QPushButton[purpose="transfers"]:pressed { background-color: $ENTITY_TRANSFERS_PRESSED$; }

QPushButton[purpose="reconciliation"] { background-color: $ENTITY_RECONCILIATION$; }
QPushButton[purpose="reconciliation"]:hover { background-color: $ENTITY_RECONCILIATION_HOVER$; }
QPushButton[purpose="reconciliation"]:pressed { background-color: $ENTITY_RECONCILIATION_PRESSED$; }

QPushButton[purpose="loans"] { background-color: $ENTITY_LOANS$; }
QPushButton[purpose="loans"]:hover { background-color: $ENTITY_LOANS_HOVER$; }
QPushButton[purpose="loans"]:pressed { background-color: $ENTITY_LOANS_PRESSED$; }

QPushButton[purpose="credit_cards"] { background-color: $ENTITY_CREDIT_CARDS$; }
QPushButton[purpose="credit_cards"]:hover { background-color: $ENTITY_CREDIT_CARDS_HOVER$; }
QPushButton[purpose="credit_cards"]:pressed { background-color: $ENTITY_CREDIT_CARDS_PRESSED$; }

/* ========== QDialogButtonBox ========== */

QDialogButtonBox {
    spacing: 8px;
}

/* Единый размер всех кнопок во всех диалогах — без setMinimumWidth в Python */
QDialogButtonBox QPushButton {
    border-radius: 4px;
    padding: 5px 10px;
    font-weight: 500;
    font-size: $FONT_SIZE_COMPACT$;
    margin: 1px;
}